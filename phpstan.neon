includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # Models declare casts via the Laravel 11 `casts()` method, so Larastan must
    # parse that method statically to type enum/date-cast attributes correctly.
    parseModelCastsMethod: true
